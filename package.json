{
  "name": "sudocode",
  "version": "1.0.0",
  "private": true,
  "description": "IDE, interpreter and converter for Edexcel IGCSE pseudocode, Cambridge 9618 pseudocode and syllabus Python",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "py:expect": "scripts/py-expect.sh",
    "test:core": "vitest run --project core",
    "spec:coverage": "node scripts/spec-coverage.ts",
    "check": "node scripts/check.ts",
    "format": "prettier --write .",
    "dev": "pnpm --filter @sudocode/web dev",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
