SET Names TO ['Ali', 'Bea', 'Cal']
FOR EACH n FROM Names DO
  SEND n TO DISPLAY
END FOREACH
FOR EACH c FROM 'Hi!' DO
  SEND c TO DISPLAY
END FOREACH
FOR EACH x FROM '' DO
  SEND 'never' TO DISPLAY
END FOREACH
SET total TO 0
FOR EACH s FROM [10, 25, 5] DO
  SET total TO total + s
END FOREACH
SEND total TO DISPLAY
