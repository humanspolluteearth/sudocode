CONST INTEGER Limit
SET Limit TO 3
SET count TO 0
WHILE count < Limit DO
  SET count TO count + 1
END WHILE
REPEAT
  SET count TO count - 1
UNTIL count = 0
REPEAT 2 TIMES
  SEND 'x' TO DISPLAY
END REPEAT
FOR i FROM 1 TO 2 STEP 1 DO
  IF i MOD 2 = 0 AND NOT FALSE OR i DIV 1 = 5 THEN
    SEND i TO DISPLAY
  ELSE
    SEND -i TO DISPLAY
  END IF
END FOR
FOR EACH c FROM 'ab' DO
  SEND c TO DISPLAY
END FOREACH
