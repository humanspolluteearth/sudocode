CLASS Counter
  PRIVATE Count : INTEGER
  PUBLIC PROCEDURE NEW()
    Count <- 0
  ENDPROCEDURE
  PUBLIC PROCEDURE Add(N : INTEGER)
    Count <- Count + N
  ENDPROCEDURE
  PUBLIC FUNCTION Get() RETURNS INTEGER
    RETURN Count
  ENDFUNCTION
ENDCLASS
DECLARE C : Counter
C <- NEW Counter()
C.Add(5)
C.Add(2)
OUTPUT C.Get()
